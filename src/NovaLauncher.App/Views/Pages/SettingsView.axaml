<views:NovaPage
    x:Class="NovaLauncher.App.Views.Pages.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NovaLauncher.App.Views"
    xmlns:themes="using:NovaLauncher.Application.Themes"
    xmlns:syncDomain="using:NovaLauncher.Domain.SaveSync"
    xmlns:profiles="using:NovaLauncher.Domain.Profiles"
    xmlns:library="using:NovaLauncher.Application.Library"
    xmlns:vm="using:NovaLauncher.Application"
    x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,28,36,44" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="4"><TextBlock Text="Settings" Classes="page-title" /><TextBlock Text="Appearance, private devices, updates, and local diagnostics." Classes="page-subtitle" /></StackPanel>

      <Border Classes="card"><StackPanel Spacing="9"><TextBlock Text="Shared-screen presentation" Classes="section-title" /><CheckBox Content="Hide marked games while browsing this profile on a shared screen" IsChecked="{Binding Workspace.SharedScreenMode}" AutomationProperties.Name="Enable family-safe shared-screen presentation mode" /><TextBlock Text="This only hides marked games from Home, Library, search, statistics, and controller browsing. It is not parental-control security and does not restrict files, accounts, or direct launch access." Classes="caption" TextWrapping="Wrap" /></StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Profile backup &amp; restore" Classes="section-title" /><TextBlock Text="Backups identify profile-scoped content separately from device-scoped credentials. Restore always requires preview and explicit destination choice." Classes="caption" TextWrapping="Wrap" /><WrapPanel ItemSpacing="8"><Button Content="Export active profile" Click="OnExportActiveProfile" AutomationProperties.Name="Export active local profile without device credentials" /><Button Content="Preview profile backup" Click="OnPreviewProfileBackup" AutomationProperties.Name="Preview local profile backup before restore" /></WrapPanel><StackPanel IsVisible="{Binding Workspace.HasProfileBackupPreview}" Spacing="8"><ItemsControl ItemsSource="{Binding Workspace.ProfileBackupScopeNotes}" AutomationProperties.Name="Profile backup scope explanation"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding Workspace.ProfileBackupItems}" AutomationProperties.Name="Reviewed profile backup games"><ItemsControl.ItemTemplate><DataTemplate x:DataType="library:ReviewedProfileBackupItem"><CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Preview.IsValid}" AutomationProperties.Name="Select validated profile game for restore"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><StackPanel><TextBlock Text="{Binding Preview.Game.Entry.Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Preview.Message}" Classes="caption" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Preview.IsValid, StringFormat='Valid: {0}'}" /></Grid></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBox Text="{Binding Workspace.ImportedProfileName}" MaxLength="100" PlaceholderText="Imported profile name" AutomationProperties.Name="Imported local profile name" /><WrapPanel ItemSpacing="8"><Button Classes="primary" Content="Import as new profile" Click="OnImportProfileBackupAsNew" AutomationProperties.Name="Import reviewed backup as a new local profile" /><Button Content="Replace active profile" Click="OnRestoreProfileBackupOverActive" AutomationProperties.Name="Replace active profile from reviewed backup" /></WrapPanel></StackPanel></StackPanel></Border>

      <Border Classes="elevated-card"><StackPanel Spacing="10"><TextBlock Text="Local profiles" Classes="section-title" /><TextBlock Text="{Binding Workspace.ActiveProfileName, StringFormat='Active profile: {0}'}" FontWeight="SemiBold" AutomationProperties.Name="Active local profile identity" /><TextBlock Text="Profiles organize local libraries and preferences; they are not accounts or security boundaries. Device pairing credentials remain outside profiles." Classes="caption" TextWrapping="Wrap" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding Workspace.LocalProfiles}" SelectedItem="{Binding Workspace.SelectedProfile}" AutomationProperties.Name="Choose local library profile"><ComboBox.ItemTemplate><DataTemplate x:DataType="profiles:LocalProfile"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Classes="primary" Content="Switch profile" Click="OnSwitchLocalProfile" AutomationProperties.Name="Switch active local library profile" /></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Workspace.ProfileName}" MaxLength="100" PlaceholderText="New profile name" AutomationProperties.Name="New local profile name" /><Button Grid.Column="1" Content="Create profile" Click="OnCreateLocalProfile" AutomationProperties.Name="Create local library profile" /></Grid></StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Profile discovery locations" Classes="section-title" /><TextBlock Text="Reusable folders and ignored paths apply only to the active profile. Scans remain user-initiated and never run silently at startup." Classes="caption" TextWrapping="Wrap" /><Grid ColumnDefinitions="*,*" ColumnSpacing="16"><StackPanel Spacing="6"><TextBlock Text="Reusable locations" FontWeight="SemiBold" /><ListBox ItemsSource="{Binding Workspace.DiscoveryLocations}" SelectedItem="{Binding Workspace.SelectedDiscoveryLocation}" MaxHeight="140" AutomationProperties.Name="Active profile reusable discovery locations" /><WrapPanel ItemSpacing="8"><Button Content="Add folder" Click="OnAddDiscoveryLocation" AutomationProperties.Name="Add reusable discovery folder" /><Button Content="Scan selected" Click="OnScanSelectedDiscoveryLocation" AutomationProperties.Name="Scan selected reusable discovery folder now" /><Button Content="Remove selected" Click="OnRemoveDiscoveryLocation" AutomationProperties.Name="Remove selected discovery folder" /></WrapPanel></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Ignored paths" FontWeight="SemiBold" /><ListBox ItemsSource="{Binding Workspace.IgnoredDiscoveryPaths}" SelectedItem="{Binding Workspace.SelectedIgnoredDiscoveryPath}" MaxHeight="140" AutomationProperties.Name="Active profile ignored discovery paths" /><WrapPanel ItemSpacing="8"><Button Content="Ignore folder" Click="OnAddIgnoredDiscoveryPath" AutomationProperties.Name="Add ignored discovery path" /><Button Content="Remove selected" Click="OnRemoveIgnoredDiscoveryPath" AutomationProperties.Name="Remove selected ignored discovery path" /></WrapPanel></StackPanel></Grid></StackPanel></Border>

      <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Windows startup &amp; tray" Classes="section-title" /><CheckBox Content="Start NovaLauncher with Windows" IsChecked="{Binding Workspace.StartWithWindows}" AutomationProperties.Name="Start NovaLauncher with Windows disabled by default" /><CheckBox Content="Keep NovaLauncher in the notification area when closing the window" IsChecked="{Binding Workspace.MinimizeToTray}" AutomationProperties.Name="Minimize NovaLauncher to notification area disabled by default" /><Button Content="Apply startup behavior" Click="OnApplyStartupBehavior" HorizontalAlignment="Left" AutomationProperties.Name="Apply optional Windows startup and tray behavior" /><TextBlock Text="Both options are disabled by default. Disabling startup removes NovaLauncher's current-user autorun entry; no background scan or provider check is added." Classes="caption" TextWrapping="Wrap" /></StackPanel></Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
        <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Appearance &amp; accessibility" Classes="section-title" /><ComboBox ItemsSource="{Binding Workspace.ThemeOptions}" SelectedValue="{Binding Workspace.SelectedThemeId}" SelectedValueBinding="{Binding Id}" AutomationProperties.Name="Built-in color theme"><ComboBox.ItemTemplate><DataTemplate x:DataType="themes:ThemeOption"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Apply theme" Click="OnApplyTheme" AutomationProperties.Name="Apply selected built-in theme" /><CheckBox Content="Reduce motion" IsChecked="{Binding Workspace.ReduceMotion}" AutomationProperties.Name="Reduce interface motion" /><Button Content="Apply motion preference" Click="OnApplyMotionPreference" AutomationProperties.Name="Apply interface motion preference" /><TextBlock Text="Text size (100–200%)" Classes="caption" /><Slider Minimum="1" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Workspace.TextScale}" AutomationProperties.Name="Interface text scale" /><TextBlock Text="Focus indicator size (100–200%)" Classes="caption" /><Slider Minimum="1" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Workspace.FocusScale}" AutomationProperties.Name="Keyboard and controller focus indicator scale" /><ComboBox ItemsSource="{Binding Workspace.ContrastPresetOptions}" SelectedItem="{Binding Workspace.ContrastPreset}" AutomationProperties.Name="Contrast preset" /><ComboBox ItemsSource="{Binding Workspace.CultureOptions}" SelectedItem="{Binding Workspace.Culture}" AutomationProperties.Name="Reviewed interface language" /><CheckBox Content="Show controller button hints" IsChecked="{Binding Workspace.ShowControllerHints}" AutomationProperties.Name="Show controller button hints" /><Button Content="Apply accessibility preferences" Click="OnApplyAccessibilityPreferences" AutomationProperties.Name="Apply text focus contrast hints and language preferences" /><Button Classes="primary" Content="Enter controller mode" Click="OnEnterControllerMode" AutomationProperties.Name="Enter full screen controller mode" /><TextBlock Text="Controller mode detects Windows XInput and generic joystick/DirectInput-compatible controllers. Use the D-pad or left stick to move, A to activate, B to go back, and X for context actions. Button order on generic devices can vary." IsVisible="{Binding Workspace.ShowControllerHints}" Classes="caption" TextWrapping="Wrap" /><TextBlock Text="English (United States) is the initial fully reviewed language. A non-shipping expanded pseudo-locale exercises text growth before additional languages are offered. Five built-in themes are available; downloaded themes are never loaded." Classes="caption" TextWrapping="Wrap" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="card"><StackPanel Spacing="10"><TextBlock Text="Metadata artwork" Classes="section-title" /><TextBlock Text="Optional SteamGridDB access is kept only for this running session and excluded from logs and backups." Classes="caption" TextWrapping="Wrap" /><TextBox PasswordChar="●" Text="{Binding Workspace.SteamGridDbApiKey}" PlaceholderText="SteamGridDB API key" AutomationProperties.Name="SteamGridDB API key" /><Button Content="Apply API key" Click="OnApplySteamGridDbKey" HorizontalAlignment="Left" AutomationProperties.Name="Apply SteamGridDB API key for this session" /><TextBlock Text="{Binding Workspace.SteamGridDbKeyStatus}" TextWrapping="Wrap" /></StackPanel></Border>
      </Grid>

      <Border Classes="elevated-card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4"><TextBlock Text="Trusted devices &amp; private sync" Classes="section-title" /><TextBlock Text="Tailscale provides the private network. NovaLauncher pins each trusted device independently." Classes="page-subtitle" /></StackPanel>
          <TextBlock Text="{Binding Workspace.SaveSyncIdentity}" TextWrapping="Wrap" AutomationProperties.Name="Stable NovaLauncher device identity" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding Workspace.TailscalePeerAddress}" PlaceholderText="100.64.x.x or fd7a:115c:a1e0::…" AutomationProperties.Name="Tailscale peer IP address" /><Button Grid.Column="1" Content="Validate and save" Click="OnSaveTailscalePeer" AutomationProperties.Name="Validate and save Tailscale peer address" /><Button Grid.Column="2" Content="Retry listener" Click="OnRetrySaveSyncListener" AutomationProperties.Name="Retry Tailscale save-sync network listener" /></Grid>
          <Border Classes="success-notice" IsVisible="{Binding Workspace.IsSaveSyncListening}"><TextBlock Text="{Binding Workspace.SaveSyncListenerStatus, StringFormat='NETWORK READY · {0}'}" TextWrapping="Wrap" AutomationProperties.Name="Save sync listener ready" /></Border>
          <Border Classes="danger-notice" IsVisible="{Binding Workspace.IsSaveSyncNotListening}"><TextBlock Text="{Binding Workspace.SaveSyncListenerStatus, StringFormat='NETWORK NOT READY · {0}'}" TextWrapping="Wrap" AutomationProperties.Name="Save sync listener inactive" /></Border>
          <Border Classes="paired-notice" IsVisible="{Binding Workspace.IsSaveSyncPaired}" AutomationProperties.Name="Save sync paired status"><StackPanel><TextBlock Text="PAIRED" FontWeight="Bold" /><TextBlock Text="{Binding Workspace.SaveSyncPairingStatus}" TextWrapping="Wrap" /></StackPanel></Border>
          <Border Classes="warning-notice" IsVisible="{Binding Workspace.IsSaveSyncNotPaired}" AutomationProperties.Name="Save sync not paired status"><StackPanel><TextBlock Text="NOT PAIRED" FontWeight="Bold" /><TextBlock Text="{Binding Workspace.SaveSyncPairingStatus}" TextWrapping="Wrap" /></StackPanel></Border>
          <TextBlock Text="{Binding Workspace.SaveSyncPairingFeedback}" TextWrapping="Wrap" AutomationProperties.Name="Save sync pairing result" />
          <TextBox PasswordChar="●" Text="{Binding Workspace.PairingCode}" PlaceholderText="123 456" AutomationProperties.Name="NovaLauncher 24-hour device invitation" />
          <WrapPanel ItemSpacing="8"><Button Classes="primary" Content="Generate 24-hour invitation" Click="OnGeneratePairingCode" AutomationProperties.Name="Generate a single-use 24-hour save-sync invitation" /><Button Content="Copy code" Click="OnCopyInvitationCode" AutomationProperties.Name="Copy six-digit invitation code" /><Button Content="Paste code" Click="OnPasteInvitationCode" AutomationProperties.Name="Paste six-digit invitation code" /><Button Content="Accept invitation" Click="OnApplyPairingCode" IsEnabled="{Binding Workspace.CanAcceptPairingInvitation}" AutomationProperties.Name="Accept save-sync invitation from trusted device" /><Button Content="Refresh status" Click="OnRefreshPairingStatus" AutomationProperties.Name="Refresh save-sync pairing status" /><Button Content="Revoke paired device" Click="OnRevokePairedDevice" AutomationProperties.Name="Revoke the paired save-sync device" /></WrapPanel>
          <TextBlock Text="Accept invitation becomes available after entering the sender's Tailscale IP and a six-digit code." Classes="caption" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="16" Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding Workspace.TrustedSaveSyncPeers}" SelectedItem="{Binding Workspace.SelectedTrustedPeer}" MinHeight="130" MaxHeight="220" AutomationProperties.Name="Independently trusted save-sync devices"><ListBox.ItemTemplate><DataTemplate x:DataType="syncDomain:TrustedSaveSyncPeer"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Address}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Column="1" Spacing="8"><TextBox Text="{Binding Workspace.TrustedPeerName}" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" PlaceholderText="Trusted device name" AutomationProperties.Name="Selected trusted device name" /><Button Content="Rename selected" Click="OnRenameTrustedPeer" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" AutomationProperties.Name="Rename selected trusted device" /><Button Content="Pause or resume" Click="OnToggleTrustedPeer" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" AutomationProperties.Name="Pause or resume selected trusted device" /><Button Content="Rotate credential" Click="OnRotateTrustedPeerCredential" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" AutomationProperties.Name="Rotate selected trusted device credential" /><Button Content="Revoke selected" Click="OnRevokeTrustedPeer" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" AutomationProperties.Name="Independently revoke selected trusted device" /></StackPanel>
          </Grid>
          <TextBlock Text="Steam-imported games remain on Steam Cloud where supported." Classes="caption" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10"><TextBlock Text="Official updates" Classes="section-title" /><TextBlock Text="Checks occur only when requested and target the fixed official GitHub repository. Staging requires the expected hash and pinned Windows publisher signature." Classes="caption" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding Workspace.UpdateChannelOptions}" SelectedItem="{Binding Workspace.SelectedUpdateChannel}" AutomationProperties.Name="Official NovaLauncher update channel" /><WrapPanel ItemSpacing="8"><Button Content="Check for updates" Click="OnCheckForUpdates" AutomationProperties.Name="Check official NovaLauncher releases" /><Button Content="Verify and stage installer" Click="OnStageUpdate" IsEnabled="{Binding Workspace.HasAvailableUpdate}" AutomationProperties.Name="Verify and stage signed NovaLauncher installer" /></WrapPanel><ProgressBar Minimum="0" Maximum="100" Value="{Binding Workspace.UpdateProgress}" AutomationProperties.Name="Official update download progress" /><TextBlock Text="{Binding Workspace.UpdateStatus}" TextWrapping="Wrap" AutomationProperties.Name="Official update status" /><TextBlock Text="{Binding Workspace.AvailableUpdate.ReleaseNotes}" IsVisible="{Binding Workspace.HasAvailableUpdate}" MaxHeight="180" TextWrapping="Wrap" AutomationProperties.Name="Official update release notes" /><CheckBox Content="I reviewed the release notes and want Windows Setup to open the verified installer" IsChecked="{Binding Workspace.ConfirmUpdateInstall}" AutomationProperties.Name="Confirm launching verified NovaLauncher installer" /><Button Content="Open verified installer" Click="OnLaunchStagedUpdate" IsEnabled="{Binding Workspace.CanLaunchStagedUpdate}" HorizontalAlignment="Left" AutomationProperties.Name="Open reverified NovaLauncher installer" /><TextBlock Text="Unsigned builds without an embedded publisher pin fail closed." Classes="caption" /></StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="9"><TextBlock Text="Support &amp; diagnostics" Classes="section-title" /><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><StackPanel Spacing="6"><TextBlock Text="{Binding Version, StringFormat='Version {0}'}" /><TextBlock Text="{Binding Workspace.Games.Count, StringFormat='{}{0} visible library items'}" /><TextBlock Text="{Binding Workspace.AchievementSummary, StringFormat='Achievements: {0}'}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding Workspace.CrashRecoveryStatus}" TextWrapping="Wrap" AutomationProperties.Name="Previous session recovery status" /><TextBlock Text="{Binding Workspace.UpdateRecoveryStatus}" TextWrapping="Wrap" AutomationProperties.Name="Failed update rollback status" /></StackPanel></Grid><WrapPanel ItemSpacing="8"><Button Content="Open verified rollback installer" Click="OnRollbackUpdate" IsEnabled="{Binding Workspace.CanRollbackUpdate}" AutomationProperties.Name="Open verified previous NovaLauncher installer" /><Button Content="Export sanitized diagnostics" Click="OnExportDiagnostics" AutomationProperties.Name="Export sanitized local diagnostics" /></WrapPanel><TextBlock Text="Logs remain structured and local; API keys and raw account identifiers are excluded." Classes="caption" TextWrapping="Wrap" /></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</views:NovaPage>
