<views:NovaPage
    x:Class="NovaLauncher.App.Views.Pages.DownloadsSharingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NovaLauncher.App.Views"
    xmlns:transfers="using:NovaLauncher.Application.GameTransfer"
    xmlns:syncDomain="using:NovaLauncher.Domain.SaveSync"
    xmlns:vm="using:NovaLauncher.Application"
    x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,28,32,44" Spacing="24" MaxWidth="1280" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="5">
          <TextBlock Text="Downloads &amp; Sharing" Classes="page-title" />
          <TextBlock Text="Private transfers between trusted devices" Classes="page-subtitle" />
        </StackPanel>
        <Border Grid.Column="1" Classes="trust-status" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="{DynamicResource ThemeSuccess}" /><TextBlock Text="Trusted devices" FontWeight="SemiBold" /><TextBlock Text="{Binding Workspace.TrustedSaveSyncPeers.Count, StringFormat='{}{0} available'}" Classes="caption" VerticalAlignment="Center" /></StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="0">
        <Button Classes="segment active" Content="Active" AutomationProperties.Name="Show active sharing transfers" />
        <Button Grid.Column="1" Classes="segment" Content="Send" AutomationProperties.Name="Show send game workflow" />
        <Button Grid.Column="2" Classes="segment" Content="Receive" AutomationProperties.Name="Show receive game workflow" />
        <Button Grid.Column="3" Classes="segment" Content="History" AutomationProperties.Name="Show game sharing history" />
        <Button Grid.Column="4" Classes="quiet" Content="Refresh offers and history" Click="OnRefreshSharing" HorizontalAlignment="Right" AutomationProperties.Name="Refresh sharing offers and history" />
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
        <Border Classes="professional-card">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4"><TextBlock Text="Share a game" Classes="section-title" /><TextBlock Text="Choose a manual game folder you own or are authorized to copy." Classes="caption" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Spacing="7"><TextBlock Text="Game folder" Classes="field-label" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Workspace.GameTransferSourceFolder}" PlaceholderText="Choose an eligible game folder" AutomationProperties.Name="Authorized manual game source folder" /><Button Grid.Column="1" Content="Choose…" Click="OnChooseGameTransferSource" AutomationProperties.Name="Choose and recursively scan manual game transfer source folder" /></Grid></StackPanel>
            <Border Classes="subtle-panel" IsVisible="{Binding Workspace.HasGameTransferPreview}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24"><StackPanel><TextBlock Text="Review ready" FontWeight="SemiBold" /><TextBlock Text="Every regular file was included in the bounded manifest." Classes="caption" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Files" Classes="field-label" /><TextBlock Text="{Binding Workspace.GameTransferPreview.Files.Count, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Total bytes" Classes="field-label" /><TextBlock Text="{Binding Workspace.GameTransferPreview.TotalBytes, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Grid>
            </Border>
            <StackPanel Spacing="7"><TextBlock Text="Send to trusted device" Classes="field-label" /><ComboBox ItemsSource="{Binding Workspace.TrustedSaveSyncPeers}" SelectedItem="{Binding Workspace.SelectedTrustedPeer}" PlaceholderText="Choose a recipient" AutomationProperties.Name="Trusted game transfer recipient"><ComboBox.ItemTemplate><DataTemplate x:DataType="syncDomain:TrustedSaveSyncPeer"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding DisplayName}" /><TextBlock Grid.Column="1" Text="{Binding State}" Classes="caption" /></Grid></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            <CheckBox Content="I confirm I own or am authorized to copy this game folder" IsChecked="{Binding Workspace.GameTransferRightsAttested}" AutomationProperties.Name="Attest game copy rights" />
            <TextBlock Text="{Binding Workspace.GameTransferAuthorizationHint}" Classes="caption" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Classes="primary" Content="Review and share" Click="OnAuthorizeGameTransfer" IsEnabled="{Binding Workspace.CanAuthorizeGameTransfer}" HorizontalAlignment="Stretch" AutomationProperties.Name="Authorize reviewed game transfer to selected peer" /><Button Grid.Column="1" Content="Rescan" Click="OnPreviewGameTransfer" AutomationProperties.Name="Rescan bounded game transfer manifest" /></Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="professional-card">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4"><TextBlock Text="Incoming offers" Classes="section-title" /><TextBlock Text="Review the sender, size, and destination before receiving anything." Classes="caption" TextWrapping="Wrap" /></StackPanel>
            <ListBox ItemsSource="{Binding Workspace.PeerGameTransferOffers}" SelectedItem="{Binding Workspace.SelectedGameTransferOffer}" MinHeight="126" MaxHeight="220" Classes="clean-list" AutomationProperties.Name="Authorized peer game transfer offers">
              <ListBox.ItemTemplate><DataTemplate x:DataType="transfers:PeerGameTransferOffer"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="8,7"><StackPanel Spacing="3"><TextBlock Text="{Binding Manifest.PackageName}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Peer.DisplayName, StringFormat='From {0}'}" Classes="caption" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Manifest.TotalBytes, StringFormat='{}{0:N0} bytes'}" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Spacing="7"><TextBlock Text="Destination" Classes="field-label" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Workspace.GameTransferDestination}" PlaceholderText="Choose an empty destination folder" AutomationProperties.Name="Game transfer destination folder" /><Button Grid.Column="1" Content="Choose…" Click="OnChooseGameTransferDestination" AutomationProperties.Name="Choose empty game transfer destination" /></Grid></StackPanel>
            <Border Classes="subtle-panel"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse Width="9" Height="9" Fill="{DynamicResource ThemeSuccess}" VerticalAlignment="Center" /><StackPanel><TextBlock Text="Destination verification occurs before download" FontWeight="SemiBold" /><TextBlock Text="Received executables are verified but never launched automatically." Classes="caption" TextWrapping="Wrap" /></StackPanel></StackPanel></Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Classes="primary" Content="Download or resume" Click="OnDownloadGameTransfer" HorizontalAlignment="Stretch" AutomationProperties.Name="Download or resume verified peer game transfer" /><Button Grid.Column="1" Content="Refresh offers" Click="OnRefreshGameTransferOffers" AutomationProperties.Name="Refresh authorized peer game transfer offers" /></Grid>
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><TextBlock Text="Active transfer" Classes="section-title" /><Border Grid.Column="1" Classes="status-badge" HorizontalAlignment="Right"><TextBlock Text="{Binding Workspace.GameTransferStatus}" MaxWidth="720" TextWrapping="Wrap" Classes="caption" AutomationProperties.Name="Game transfer status and offer refresh details" /></Border></Grid>
        <Border Classes="transfer-row">
          <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="4"><TextBlock Text="Private game transfer" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Verified chunks are retained when a transfer is paused." Classes="caption" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Progress" Classes="field-label" /><TextBlock Grid.Column="1" Text="{Binding Workspace.GameTransferProgress, StringFormat='{}{0:F0}%'}" FontWeight="SemiBold" /></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding Workspace.GameTransferProgress}" Height="6" AutomationProperties.Name="Peer game transfer byte progress" /></StackPanel>
            <WrapPanel Grid.Column="2" ItemSpacing="8" VerticalAlignment="Center"><Button Content="Pause" Click="OnPauseGameTransfer" IsEnabled="{Binding Workspace.IsGameTransferActive}" AutomationProperties.Name="Pause active game transfer" /><Button Classes="quiet" Content="View history" Click="OnRefreshGameTransferHistory" AutomationProperties.Name="Refresh game sharing history" /></WrapPanel>
          </Grid>
        </Border>
      </StackPanel>

      <Expander Header="Transfer history" Classes="panel-expander"><ItemsControl ItemsSource="{Binding Workspace.GameTransferHistory}" AutomationProperties.Name="Local peer game transfer audit history"><ItemsControl.ItemTemplate><DataTemplate x:DataType="transfers:GameTransferAuditItem"><Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="2,10"><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>

      <TextBlock Text="NovaLauncher shares only reviewed manual-game folders with a selected trusted device. Store-managed games are refused, DRM is never bypassed, and received code is never launched automatically." Classes="caption" TextWrapping="Wrap" MaxWidth="900" />
    </StackPanel>
  </ScrollViewer>
</views:NovaPage>
