<views:NovaPage
    x:Class="NovaLauncher.App.Views.Pages.HomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NovaLauncher.App.Views"
    xmlns:components="using:NovaLauncher.App.Views.Components"
    xmlns:domain="using:NovaLauncher.Domain.Library"
    xmlns:library="using:NovaLauncher.Application.Library"
    xmlns:vm="using:NovaLauncher.Application"
    x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,28,36,42" Spacing="24">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Home" Classes="page-title" />
          <TextBlock Text="Pick up where you left off." Classes="page-subtitle" />
        </StackPanel>
        <Button Grid.Column="1" Content="View full library  →" Click="OnShowLibrary" Classes="quiet" VerticalAlignment="Center" AutomationProperties.Name="Browse complete game library" />
      </Grid>

      <Border Classes="hero" Height="380" IsVisible="{Binding Workspace.HasFeaturedGame}" ClipToBounds="True">
        <ContentControl Content="{Binding Workspace.FeaturedGame}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="domain:LibraryItem">
        <Grid>
          <Border Background="{DynamicResource ThemeElevated}">
            <components:ManagedArtworkImage ArtworkKind="Hero" DecodeWidth="1400" Stretch="UniformToFill" Opacity="0.78" AutomationProperties.Name="Featured game hero artwork" />
          </Border>
          <Border Background="{DynamicResource ThemeHeroScrim}" />
          <Grid Margin="38" RowDefinitions="*,Auto" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Grid.Row="1" Spacing="10">
              <TextBlock Text="CONTINUE PLAYING" Classes="eyebrow" />
              <TextBlock Text="{Binding Name}" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="pill"><TextBlock Text="{Binding Platform}" /></Border>
                <Border Classes="pill"><TextBlock Text="{Binding Source}" /></Border>
                <TextBlock Text="{Binding TotalPlayTime, StringFormat='{}{0:g} played'}" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" />
              </StackPanel>
              <WrapPanel ItemSpacing="10" Margin="0,8,0,0">
                <Button Classes="primary hero-action" Content="▶  Play now" Click="OnLaunchHomeGame" AutomationProperties.Name="Launch featured game" />
                <Button Classes="glass hero-action" Content="View details" Click="OnOpenGameDetails" AutomationProperties.Name="Open featured game details" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <Border Classes="metric-card"><StackPanel Spacing="4"><TextBlock Text="LIBRARY" Classes="eyebrow" /><TextBlock Text="{Binding Workspace.LibraryGameCount}" Classes="metric" /><TextBlock Text="games available" Classes="caption" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="metric-card"><StackPanel Spacing="4"><TextBlock Text="FAVORITES" Classes="eyebrow" /><TextBlock Text="{Binding Workspace.FavoriteGameCount}" Classes="metric" /><TextBlock Text="ready to launch" Classes="caption" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="metric-card"><StackPanel Spacing="4"><TextBlock Text="PLAYTIME" Classes="eyebrow" /><TextBlock Text="{Binding Workspace.TotalLibraryPlayTime}" Classes="metric" /><TextBlock Text="monitored locally" Classes="caption" /></StackPanel></Border>
      </Grid>

      <Expander Header="Customize Home" Classes="panel-expander" AutomationProperties.Name="Customize Home sections">
        <StackPanel Margin="4,12,4,4" Spacing="10">
          <TextBlock Text="Choose a section, then show or hide it or change its position. Your layout stays on this device." Classes="caption" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding Workspace.HomeSectionOptions}" SelectedItem="{Binding Workspace.SelectedHomeSection}" MaxHeight="170" AutomationProperties.Name="Home section layout">
            <ListBox.ItemTemplate><DataTemplate x:DataType="library:HomeSectionOption"><Grid ColumnDefinitions="*,Auto" Margin="4"><TextBlock Text="{Binding DisplayName}" /><TextBlock Grid.Column="1" Text="{Binding VisibilityLabel}" Classes="eyebrow" /></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel ItemSpacing="8"><Button Content="Show or hide" Click="OnToggleHomeSection" AutomationProperties.Name="Toggle selected Home section visibility" /><Button Content="Move up" Click="OnMoveHomeSectionUp" AutomationProperties.Name="Move selected Home section up" /><Button Content="Move down" Click="OnMoveHomeSectionDown" AutomationProperties.Name="Move selected Home section down" /></WrapPanel>
        </StackPanel>
      </Expander>

      <Border Classes="warning-notice" IsVisible="{Binding Workspace.HasSaveSyncActivities}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="4"><TextBlock Text="Cross-device save activity" FontWeight="SemiBold" /><TextBlock Text="Review recent snapshots, queued work, or conflicts before launching on another device." Classes="caption" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="Review saves  →" Click="OnShowSaves" AutomationProperties.Name="Review cross-device save activity" /></Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Workspace.VisibleHomeSections}" AutomationProperties.Name="Ordered Home sections">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="library:HomeSectionViewModel">
            <StackPanel Spacing="12" Margin="0,0,0,12">
              <TextBlock Text="{Binding DisplayName}" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="domain:LibraryItem"><Button Classes="game-tile" Width="210" Height="300" Margin="0,0,16,16" Padding="0" Click="OnOpenGameDetails" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Open Home game details"><Grid RowDefinitions="230,*"><Border Background="{DynamicResource ThemeElevated}" CornerRadius="14,14,0,0" ClipToBounds="True"><Grid><TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" /><components:ManagedArtworkImage DecodeWidth="420" Stretch="UniformToFill" AutomationProperties.Name="Home game cover artwork" /></Grid></Border><StackPanel Grid.Row="1" Margin="14,9" Spacing="2"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Platform}" Classes="caption" /></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="empty-state" IsVisible="{Binding Workspace.IsEmpty}">
        <StackPanel HorizontalAlignment="Center" Spacing="10">
          <TextBlock Text="Your launcher is ready" FontSize="25" FontWeight="Bold" />
          <TextBlock Text="Open Library to add an installed game or preview your Steam library." Classes="page-subtitle" TextAlignment="Center" />
          <Button Content="Open Library" Classes="primary" Click="OnShowLibrary" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</views:NovaPage>
