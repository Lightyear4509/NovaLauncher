<Application
    x:Class="NovaLauncher.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="ThemeBackground" Color="#0B1020" />
    <SolidColorBrush x:Key="ThemeSurface" Color="#111831" />
    <SolidColorBrush x:Key="ThemeElevated" Color="#172448" />
    <SolidColorBrush x:Key="ThemeBorder" Color="#253760" />
    <SolidColorBrush x:Key="ThemeText" Color="#F7F8FC" />
    <SolidColorBrush x:Key="ThemeMuted" Color="#B8C1DF" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#63D8FF" />
    <SolidColorBrush x:Key="ThemeAccentSecondary" Color="#9B6DFF" />
    <SolidColorBrush x:Key="ThemeSuccess" Color="#54D89B" />
    <SolidColorBrush x:Key="ThemeWarning" Color="#F4BF58" />
    <SolidColorBrush x:Key="ThemeDanger" Color="#FF6B7A" />
    <SolidColorBrush x:Key="ThemeOverlay" Color="#D90B1020" />
    <SolidColorBrush x:Key="ThemeNavSelected" Color="#263E72" />
    <SolidColorBrush x:Key="ThemeButton" Color="#253760" />
    <SolidColorBrush x:Key="ThemeButtonHover" Color="#36558C" />
    <SolidColorBrush x:Key="ThemeButtonPressed" Color="#182A50" />
    <SolidColorBrush x:Key="ThemeHeroScrim" Color="#B8090E1A" />
    <SolidColorBrush x:Key="ThemeCardScrim" Color="#99080D1A" />
    <x:TimeSpan x:Key="MotionDuration">0:0:0.16</x:TimeSpan>
    <x:Double x:Key="InterfaceFontSize">14</x:Double>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>
    <x:Boolean x:Key="ControllerHintsVisible">True</x:Boolean>
    <x:String x:Key="NavHome">⌂  _Home</x:String>
    <x:String x:Key="NavLibrary">▦  _Library</x:String>
    <x:String x:Key="NavSaves">⇅  _Saves</x:String>
    <x:String x:Key="NavSettings">⚙  Se_ttings</x:String>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource ThemeBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="{DynamicResource InterfaceFontSize}" />
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
    </Style>
    <Style Selector="TextBox:focus, ComboBox:focus, ListBoxItem:focus-visible, CheckBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="Background" Value="{DynamicResource ThemeButton}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="{DynamicResource MotionDuration}" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonHover}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonPressed}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSecondary}" />
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}" />
    </Style>
    <Style Selector="Button.glass">
      <Setter Property="Background" Value="{DynamicResource ThemeOverlay}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeMuted}" />
    </Style>
    <Style Selector="Button.hero-action">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="24,11" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.game-tile">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDuration}" />
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDuration}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.game-tile:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.row-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.game-card">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDuration}" />
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDuration}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.game-card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.elevated-card">
      <Setter Property="Background" Value="{DynamicResource ThemeElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource ThemeNavSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="BorderThickness" Value="0,0,2,0" />
    </Style>
    <Style Selector="Border.hero">
      <Setter Property="Background" Value="{DynamicResource ThemeElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="22" />
    </Style>
    <Style Selector="Border.metric-card">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{DynamicResource ThemeOverlay}" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="11,5" />
    </Style>
    <Style Selector="Border.selection-bar">
      <Setter Property="Background" Value="{DynamicResource ThemeNavSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.warning-notice">
      <Setter Property="Background" Value="#4A3A1C" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeWarning}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.danger-zone">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeDanger}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.success-notice">
      <Setter Property="Background" Value="#183D2C" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeSuccess}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.danger-notice">
      <Setter Property="Background" Value="#4A2424" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeDanger}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.paired-notice">
      <Setter Property="Background" Value="{DynamicResource ThemeNavSelected}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Expander.panel-expander">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Expander.panel-expander ToggleButton">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="Expander.panel-expander ToggleButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeButtonHover}" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource ThemeElevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{DynamicResource ThemeOverlay}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.empty-state">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="34" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="Background" Value="{DynamicResource ThemeElevated}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource ThemeOverlay}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="36" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.5" />
    </Style>
    <Style Selector="TextBlock.page-subtitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="29" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
  </Application.Styles>
</Application>
