<Window
    x:Class="NovaLauncher.App.MainWindow"
    x:Name="RootWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NovaLauncher.App"
    xmlns:domain="using:NovaLauncher.Domain.Library"
    xmlns:library="using:NovaLauncher.Application.Library"
    xmlns:steam="using:NovaLauncher.Application.Steam"
    xmlns:achievements="using:NovaLauncher.Domain.Achievements"
    xmlns:themes="using:NovaLauncher.Application.Themes"
    xmlns:enrichment="using:NovaLauncher.Application.Enrichment"
    xmlns:saves="using:NovaLauncher.Application.SaveSync"
    xmlns:transfers="using:NovaLauncher.Application.GameTransfer"
    xmlns:syncDomain="using:NovaLauncher.Domain.SaveSync"
    xmlns:vm="using:NovaLauncher.Application"
    x:DataType="vm:MainWindowViewModel"
    Title="NovaLauncher"
    Icon="avares://NovaLauncher.App/Assets/NovaLauncher.ico"
    Width="1320"
    Height="820"
    MinWidth="820"
    MinHeight="600"
    AutomationProperties.Name="{x:Static local:ShellAccessibility.MainWindow}"
    Opened="OnOpened"
    Closed="OnClosed">
  <Grid RowDefinitions="76,*,Auto,Auto">
    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource ThemeElevated}" ClipToBounds="True">
          <Image Source="avares://NovaLauncher.App/Assets/novalauncher-mark-concept.png" Stretch="Uniform" Margin="5" AutomationProperties.Name="NovaLauncher brand mark" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ProductName}" LetterSpacing="0.4" />
          <TextBlock Text="YOUR GAMES · YOUR SPACE" Classes="eyebrow" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Classes="subtle" Content="←" Click="OnNavigateBack" IsEnabled="{Binding Workspace.CanNavigateBack}" ToolTip.Tip="Back" AutomationProperties.Name="Go to previous page" />
          <Button Classes="subtle" Content="→" Click="OnNavigateForward" IsEnabled="{Binding Workspace.CanNavigateForward}" ToolTip.Tip="Forward" AutomationProperties.Name="Go to next page" />
        </StackPanel>
        <Border Grid.Column="4" Background="{DynamicResource ThemeElevated}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="99" Padding="14,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource ThemeSuccess}" />
            <TextBlock Text="LOCAL-FIRST" Classes="eyebrow" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Border Width="{Binding Workspace.NavigationPaneWidth}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="12,20">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
          <StackPanel Spacing="8">
            <Button Classes="subtle" Content="☰" Click="OnToggleNavigation" ToolTip.Tip="Expand or collapse navigation" AutomationProperties.Name="Toggle navigation size" />
            <TextBlock Text="EXPLORE" Classes="eyebrow" Margin="12,0,0,8" IsVisible="{Binding Workspace.IsNavigationExpanded}" />
          </StackPanel>
          <Button Grid.Row="1" Classes="nav" Content="{Binding Workspace.HomeNavigationLabel}" Click="OnShowHome" ToolTip.Tip="Home" AutomationProperties.Name="Open Home page" />
          <Button Grid.Row="2" Classes="nav" Content="{Binding Workspace.LibraryNavigationLabel}" Click="OnShowLibrary" ToolTip.Tip="Library" AutomationProperties.Name="Open Library page" />
          <StackPanel Grid.Row="4" Spacing="8">
            <Button Classes="nav" Content="{Binding Workspace.SavesNavigationLabel}" Click="OnShowSaves" ToolTip.Tip="Saves" AutomationProperties.Name="Open Saves page" />
            <Button Classes="nav" Content="{Binding Workspace.SettingsNavigationLabel}" Click="OnShowSettings" ToolTip.Tip="Settings" AutomationProperties.Name="Open Settings and Diagnostics page" />
            <Border Classes="elevated-card" Padding="14" Margin="0,10,0,0" IsVisible="{Binding Workspace.IsNavigationExpanded}">
              <StackPanel Spacing="5">
                <TextBlock Text="PRIVATE BY DESIGN" Classes="eyebrow" />
                <TextBlock Text="Your library stays local. Nothing is uploaded unless you explicitly start a supported operation." FontSize="11" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding Workspace.IsLibraryPage}">
        <Grid Margin="30" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Text="Library" Classes="page-title" />
              <TextBlock Text="Installed games on this device" Foreground="{DynamicResource ThemeMuted}" />
              <WrapPanel ItemSpacing="8" Margin="0,8,0,0">
                <TextBlock Text="{Binding Workspace.BulkSelectionSummary}" VerticalAlignment="Center" AutomationProperties.Name="Library selection count" />
                <Button Content="Favorite selected" Click="OnFavoriteSelectedGames" IsEnabled="{Binding Workspace.HasLibraryMultiSelection}" AutomationProperties.Name="Mark selected games as favorites" />
                <Button Content="Refresh selected" Click="OnRefreshSelectedGames" IsEnabled="{Binding Workspace.HasLibraryMultiSelection}" AutomationProperties.Name="Refresh metadata for selected games" />
                <Button Content="Clear selection" Click="OnClearLibrarySelection" IsEnabled="{Binding Workspace.HasLibraryMultiSelection}" AutomationProperties.Name="Clear selected library games" />
                <Button Content="{Binding Workspace.LoadMoreLibraryGamesText}" Click="OnLoadMoreLibraryGames" IsVisible="{Binding Workspace.HasMoreLibraryGames}" AutomationProperties.Name="Load more library games" />
              </WrapPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="Add installed game" Click="OnPickGameExecutable" AutomationProperties.Name="Choose an installed game executable" />
            <Button Grid.Column="2" Content="Import Steam games" Click="OnPreviewSteamImport" AutomationProperties.Name="Preview Steam library import" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="2*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding Workspace.SearchText}" PlaceholderText="Search this library" AutomationProperties.Name="Search library" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Workspace.SourceFilterOptions}" SelectedItem="{Binding Workspace.SourceFilter}" AutomationProperties.Name="Filter library by source" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Workspace.PlatformFilterOptions}" SelectedItem="{Binding Workspace.PlatformFilter}" AutomationProperties.Name="Filter library by platform" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding Workspace.AvailabilityFilterOptions}" SelectedItem="{Binding Workspace.AvailabilityFilter}" AutomationProperties.Name="Filter library by target availability" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding Workspace.SortOptions}" SelectedItem="{Binding Workspace.SelectedSort}" AutomationProperties.Name="Library sort order" />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Border Classes="toast" IsVisible="{Binding Workspace.HasMissingTargets}" HorizontalAlignment="Left">
              <TextBlock Text="{Binding Workspace.MissingTargetCount, StringFormat='{}{0} game target(s) are missing. Use the Missing target filter to review them.'}" TextWrapping="Wrap" AutomationProperties.Name="Missing game target warning" />
            </Border>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Workspace.Collections}" SelectedItem="{Binding Workspace.LibraryCollectionFilter}" PlaceholderText="All collections" AutomationProperties.Name="Filter library by collection">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="domain:GameCollection"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="Clear collection" Click="OnClearLibraryCollectionFilter" IsEnabled="{Binding Workspace.HasLibraryCollectionFilter}" AutomationProperties.Name="Clear library collection filter" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding Workspace.SmartCollectionOptions}" SelectedItem="{Binding Workspace.SmartCollectionFilter}" AutomationProperties.Name="Filter library by smart collection" />
            <Button Grid.Column="4" Content="Clear smart" Click="OnClearSmartCollectionFilter" IsEnabled="{Binding Workspace.HasSmartCollectionFilter}" AutomationProperties.Name="Clear smart collection filter" />
            <CheckBox Grid.Column="5" Content="Favorites only" IsChecked="{Binding Workspace.FavoritesOnly}" AutomationProperties.Name="Show favorite games only" VerticalAlignment="Center" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
              <Button Content="Grid" Click="OnUseLibraryGrid" AutomationProperties.Name="Show library as grid" />
              <Button Content="List" Click="OnUseLibraryList" AutomationProperties.Name="Show library as list" />
            </StackPanel>
            <ComboBox Grid.Column="7" ItemsSource="{Binding Workspace.LibraryCardSizeOptions}" SelectedItem="{Binding Workspace.LibraryCardSize}" IsVisible="{Binding Workspace.IsGridLibraryView}" AutomationProperties.Name="Library card size" />
          </Grid>
          <Border Grid.Row="3" Classes="empty-state" IsVisible="{Binding Workspace.IsEmpty}" AutomationProperties.Name="Empty library message">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <TextBlock Text="Your library is ready for its first game" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Text="Choose an installed Windows executable or preview your existing Steam library. NovaLauncher will not modify the game files." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
              <WrapPanel ItemSpacing="8" HorizontalAlignment="Center">
                <Button Classes="primary" Content="Choose installed game" Click="OnPickGameExecutable" AutomationProperties.Name="Choose first installed game executable" />
                <Button Content="Preview Steam library" Click="OnPreviewSteamImport" AutomationProperties.Name="Preview Steam library from empty state" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <ItemsControl Grid.Row="3" ItemsSource="{Binding Workspace.RenderedGames}" IsVisible="{Binding Workspace.IsGridLibraryView}" AutomationProperties.Name="Game card library">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:LibraryItem">
                <Button Classes="game-card" Width="{Binding #RootWindow.DataContext.Workspace.LibraryCardWidth}" Height="{Binding #RootWindow.DataContext.Workspace.LibraryCardHeight}" Margin="8" Padding="0" Click="OnOpenGameDetails" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Open game details">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Add or remove from selection" Click="OnToggleLibraryGameSelection" />
                      <MenuItem Header="Toggle favorite" Click="OnContextToggleFavorite" />
                      <MenuItem Header="Refresh metadata" Click="OnContextRefreshMetadata" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid RowDefinitions="Auto,*">
                    <Border Height="{Binding #RootWindow.DataContext.Workspace.LibraryCoverHeight}" Background="{DynamicResource ThemeElevated}" CornerRadius="12,12,0,0" ClipToBounds="True">
                      <Grid>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
                        <Image Stretch="UniformToFill" Loaded="OnCardArtworkLoaded" Unloaded="OnCardArtworkUnloaded" RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="Game cover artwork" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="14,10" Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeMuted}" />
                      <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource ThemeAccent}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl Grid.Row="3" ItemsSource="{Binding Workspace.RenderedGames}" IsVisible="{Binding Workspace.IsListLibraryView}" AutomationProperties.Name="Game list library">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:LibraryItem">
                <Button Classes="game-card" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Click="OnOpenGameDetails" AutomationProperties.Name="Open listed game details">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Add or remove from selection" Click="OnToggleLibraryGameSelection" />
                      <MenuItem Header="Toggle favorite" Click="OnContextToggleFavorite" />
                      <MenuItem Header="Refresh metadata" Click="OnContextRefreshMetadata" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid ColumnDefinitions="64,2*,*,*,Auto" ColumnSpacing="14">
                    <Border Width="54" Height="72" Background="{DynamicResource ThemeElevated}" CornerRadius="8" ClipToBounds="True">
                      <Image Stretch="UniformToFill" Loaded="OnCardArtworkLoaded" Unloaded="OnCardArtworkUnloaded" RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="Listed game cover artwork" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Source}" Foreground="{DynamicResource ThemeAccent}" /></StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Platform}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}" />
                    <TextBlock Grid.Column="3" Text="{Binding TotalPlayTime, StringFormat='Playtime: {0:g}'}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}" />
                    <TextBlock Grid.Column="4" Text="View details →" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="3" Background="{DynamicResource ThemeSurface}" CornerRadius="16" Padding="20" Width="520" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Workspace.IsEditorVisible}">
            <StackPanel Spacing="10">
              <TextBlock Text="Add installed game" FontSize="22" FontWeight="Bold" />
              <TextBox Text="{Binding Workspace.Name}" PlaceholderText="Game name" AutomationProperties.Name="Game name" />
              <TextBox Text="{Binding Workspace.Target}" PlaceholderText="Selected executable" IsReadOnly="True" AutomationProperties.Name="Game launch target" />
              <TextBox Text="{Binding Workspace.Platform}" PlaceholderText="Platform" AutomationProperties.Name="Game platform" />
              <Button Content="Save game" Click="OnSaveGame" AutomationProperties.Name="Save manual game" />
            </StackPanel>
          </Border>
          <Border Grid.Row="4" Classes="elevated-card" Padding="20" IsVisible="{Binding Workspace.HasDuplicateCandidates}" AutomationProperties.Name="Potential duplicate game review">
            <StackPanel Spacing="10">
              <TextBlock Text="Potential duplicates" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="Review both records, choose the survivor, then repeat the merge action to confirm. NovaLauncher never deletes installed game files." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
              <TextBlock Text="Showing the first 100 candidate pairs. Refine the library filters before continuing." IsVisible="{Binding Workspace.DuplicateReviewTruncated}" Foreground="{DynamicResource ThemeAccent}" TextWrapping="Wrap" AutomationProperties.Name="Duplicate review result limit" />
              <ItemsControl ItemsSource="{Binding Workspace.DuplicateCandidates}" AutomationProperties.Name="Potential duplicate game pairs">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="library:DuplicateReviewItem">
                    <Grid ColumnDefinitions="2*,2*,3*,Auto,Auto" ColumnSpacing="10" Margin="0,4">
                      <TextBlock Text="{Binding Primary.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Candidate.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Reason}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                      <Button Grid.Column="3" Content="Review first" Tag="Primary" Click="OnReviewDuplicate" AutomationProperties.Name="Review first potential duplicate" />
                      <Button Grid.Column="4" Content="Review second" Tag="Candidate" Click="OnReviewDuplicate" AutomationProperties.Name="Review second potential duplicate" />
                      <Button Grid.Column="3" Margin="0,40,0,0" Content="Keep first and merge" Tag="Primary" Click="OnMergeDuplicate" AutomationProperties.Name="Keep first record and merge duplicate" />
                      <Button Grid.Column="4" Margin="0,40,0,0" Content="Keep second and merge" Tag="Candidate" Click="OnMergeDuplicate" AutomationProperties.Name="Keep second record and merge duplicate" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Row="5" Background="{DynamicResource ThemeSurface}" CornerRadius="16" Padding="20" IsVisible="{Binding Workspace.HasSteamPreview}">
            <StackPanel Spacing="10">
              <TextBlock Text="Steam import preview" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="Review the detected items and skipped manifests. NovaLauncher never writes to Steam files." TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Workspace.SteamPreviewItems}" AutomationProperties.Name="Steam import preview">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="steam:SteamImportPreviewItem"><TextBlock Text="{Binding Name}" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Workspace.SteamImportFailures}" AutomationProperties.Name="Skipped Steam manifests">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="steam:SteamImportFailure">
                    <StackPanel Margin="0,4"><TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Reason}" Foreground="{DynamicResource ThemeAccent}" TextWrapping="Wrap" /></StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Import reviewed games" Click="OnCommitSteamImport" HorizontalAlignment="Left" AutomationProperties.Name="Import reviewed Steam preview" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding Workspace.IsGameDetailsPage}">
        <StackPanel Margin="30" Spacing="18">
          <Button Content="← Back to Library" Click="OnShowLibrary" HorizontalAlignment="Left" AutomationProperties.Name="Back to Library" />
          <Border Height="300" Background="{DynamicResource ThemeElevated}" CornerRadius="18" ClipToBounds="True">
            <Grid>
              <Image x:Name="SelectedCover" Stretch="UniformToFill" AutomationProperties.Name="Selected game artwork" />
              <Border VerticalAlignment="Bottom" Background="#D008101F" Padding="24,18"><TextBlock Text="{Binding Workspace.SelectedGame.Name}" FontSize="32" FontWeight="Bold" /></Border>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="28">
            <StackPanel Spacing="14">
              <WrapPanel ItemSpacing="10">
                <Button Classes="primary" Content="Play" Click="OnLaunch" AutomationProperties.Name="Launch selected game" />
                <Button Content="Locate game" Click="OnLocateSelectedGame" IsEnabled="{Binding Workspace.CanChangeManualCover}" AutomationProperties.Name="Locate replacement executable for selected manual game" />
                <Button Content="Refresh metadata" Click="OnRefreshMetadata" AutomationProperties.Name="Refresh selected game metadata and artwork" />
                <ComboBox ItemsSource="{Binding Workspace.ArtworkKindOptions}" SelectedItem="{Binding Workspace.SelectedArtworkKind}" IsEnabled="{Binding Workspace.CanChangeManualCover}" AutomationProperties.Name="Custom artwork type" />
                <Button Content="Add artwork" Click="OnAddManualCover" IsEnabled="{Binding Workspace.CanChangeManualCover}" AutomationProperties.Name="Choose custom artwork for manual game" />
                <Button Content="Remove artwork" Click="OnRemoveManualCover" IsEnabled="{Binding Workspace.CanChangeManualCover}" AutomationProperties.Name="Remove selected custom artwork from manual game" />
                <Button Content="Provider variants" Click="OnPreviewArtworkVariants" IsEnabled="{Binding Workspace.CanBrowseProviderArtwork}" AutomationProperties.Name="Review provider artwork variants" />
                <Button Content="Inspect art cache" Click="OnInspectArtworkCache" AutomationProperties.Name="Inspect managed artwork cache" />
                <Button Content="Clean orphan art" Click="OnCleanupArtworkCache" AutomationProperties.Name="Remove unreferenced managed artwork cache files" />
                <Button Content="Favorite" Click="OnToggleFavorite" AutomationProperties.Name="Toggle selected game favorite" />
                <Button Content="Edit" Click="OnEditSelectedGame" AutomationProperties.Name="Edit selected game" />
              </WrapPanel>
              <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding Workspace.HasArtworkVariants}" AutomationProperties.Name="Provider artwork variant review">
                <StackPanel Spacing="8">
                  <TextBlock Text="Provider artwork variants" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Choosing a variant downloads it through the bounded validator before it can enter the managed cache." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Workspace.ArtworkVariants}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="enrichment:ArtworkCandidate">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3" ColumnSpacing="10">
                          <StackPanel><TextBlock Text="{Binding ProviderId}" FontWeight="SemiBold" /><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource ThemeMuted}" /></StackPanel>
                          <Button Grid.Column="1" Content="Use this variant" Click="OnApplyArtworkVariant" AutomationProperties.Name="Apply this provider artwork variant" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding Workspace.CanChangeManualCover}" AutomationProperties.Name="Artwork crop and reposition controls">
                <StackPanel Spacing="8">
                  <TextBlock Text="Crop and reposition" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Percentages are measured from the top-left of the currently displayed artwork. The crop is validated and previewed immediately in the details hero after applying." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <StackPanel><TextBlock Text="Left %" /><NumericUpDown Value="{Binding Workspace.ArtworkCropX}" Minimum="0" Maximum="99" Increment="1" AutomationProperties.Name="Artwork crop left percent" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Top %" /><NumericUpDown Value="{Binding Workspace.ArtworkCropY}" Minimum="0" Maximum="99" Increment="1" AutomationProperties.Name="Artwork crop top percent" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Width %" /><NumericUpDown Value="{Binding Workspace.ArtworkCropWidth}" Minimum="1" Maximum="100" Increment="1" AutomationProperties.Name="Artwork crop width percent" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Height %" /><NumericUpDown Value="{Binding Workspace.ArtworkCropHeight}" Minimum="1" Maximum="100" Increment="1" AutomationProperties.Name="Artwork crop height percent" /></StackPanel>
                  </Grid>
                  <Button Content="Apply crop and preview" Click="OnCropSelectedArtwork" HorizontalAlignment="Left" AutomationProperties.Name="Apply artwork crop and update preview" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding Workspace.CanMatchManualGame}" AutomationProperties.Name="Manual game identity matching">
                <StackPanel Spacing="9">
                  <TextBlock Text="Game identity" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Workspace.LinkedIdentitySummary}" TextWrapping="Wrap" />
                  <TextBox Text="{Binding Workspace.IdentitySearchText}" MaxLength="200" PlaceholderText="Search title" AutomationProperties.Name="Manual game identity search title" />
                  <WrapPanel ItemSpacing="8">
                    <Button Content="Find matches" Click="OnSearchGameIdentity" AutomationProperties.Name="Search for manual game identity candidates" />
                    <Button Content="No match" Click="OnRejectGameIdentityMatches" IsEnabled="{Binding Workspace.HasIdentityCandidates}" AutomationProperties.Name="Reject all game identity candidates" />
                    <Button Content="Unlink identity" Click="OnUnlinkGameIdentity" IsEnabled="{Binding Workspace.HasLinkedIdentity}" AutomationProperties.Name="Unlink confirmed game identity" />
                  </WrapPanel>
                  <TextBlock Text="Candidates are review-only. Searching never changes the launch target or downloads artwork." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Workspace.IdentityCandidates}" AutomationProperties.Name="Manual game identity candidates">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="enrichment:GameIdentityCandidate">
                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding ProviderId}" Foreground="{DynamicResource ThemeAccent}" />
                              <TextBlock Text="{Binding MatchReason}" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Confirm match" Click="OnConfirmGameIdentity" AutomationProperties.Name="Confirm this game identity candidate" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Workspace.IdentitySearchFailures}" AutomationProperties.Name="Game identity search warnings">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeAccent}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="16" IsVisible="{Binding Workspace.CanMatchManualGame}" AutomationProperties.Name="Manual metadata overrides">
                <StackPanel Spacing="8">
                  <TextBlock Text="Your game details" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Values saved here are protected from provider refresh until you explicitly restore provider values." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                  <TextBox Text="{Binding Workspace.ManualDescription}" MaxLength="10000" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" PlaceholderText="Description" AutomationProperties.Name="Manual game description" />
                  <TextBox Text="{Binding Workspace.ManualGenres}" PlaceholderText="Genres, separated by commas" AutomationProperties.Name="Manual game genres" />
                  <TextBox Text="{Binding Workspace.ManualDevelopers}" PlaceholderText="Developers, separated by commas" AutomationProperties.Name="Manual game developers" />
                  <TextBox Text="{Binding Workspace.ManualPublishers}" PlaceholderText="Publishers, separated by commas" AutomationProperties.Name="Manual game publishers" />
                  <TextBox Text="{Binding Workspace.ManualReleaseDate}" PlaceholderText="Release date: YYYY-MM-DD" AutomationProperties.Name="Manual game release date" />
                  <WrapPanel ItemSpacing="8">
                    <Button Content="Save my details" Click="OnSaveManualMetadata" AutomationProperties.Name="Save protected manual game metadata" />
                    <Button Content="Restore provider values" Click="OnRestoreProviderMetadata" IsEnabled="{Binding Workspace.HasLinkedIdentity}" AutomationProperties.Name="Remove manual metadata protection and refresh provider values" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                  <TextBlock Text="Cross-device saves" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Workspace.SelectedSaveDirectory}" TextWrapping="Wrap" />
                  <TextBlock Text="Manual games only. Steam titles continue to use Steam Cloud." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                  <TextBlock Text="Shared save identity" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Workspace.SelectedSaveSyncIdentity}" TextWrapping="Wrap" />
                  <TextBox Text="{Binding Workspace.SaveSyncLabel}" PlaceholderText="Same game label on both devices" AutomationProperties.Name="Automatic shared save label" />
                  <Button Content="Link automatically with paired device" Click="OnLinkSaveAutomatically" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" HorizontalAlignment="Left" AutomationProperties.Name="Derive shared save identity from paired credential" />
                  <TextBlock Text="Use the same label and platform on both devices. The private identity is derived independently; neither computer must be accessed at the same time." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
                  <TextBlock Text="Advanced recovery link" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBox Text="{Binding Workspace.SaveSyncLinkCode}" PlaceholderText="Shared save identity from the matching game" AutomationProperties.Name="Shared game save identity" />
                  <WrapPanel ItemSpacing="8">
                    <Button Content="Create link" Click="OnGenerateSaveSyncLink" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Create shared save identity for selected game" />
                    <Button Content="Copy link" Click="OnCopySaveSyncLink" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Copy shared save identity" />
                    <Button Content="Paste link" Click="OnPasteSaveSyncLink" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Paste shared save identity" />
                    <Button Content="Apply link" Click="OnApplySaveSyncLink" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Apply shared save identity to selected game" />
                  </WrapPanel>
                  <WrapPanel ItemSpacing="8">
                    <Button Content="Choose save folder" Click="OnChooseSaveFolder" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Choose manual game save folder" />
                    <Button Content="Remove save mapping" Click="OnClearSaveFolder" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Remove manual game save folder mapping" />
                    <Button Content="Sync now" Click="OnSyncSelectedGameNow" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Upload selected game saves now" />
                  </WrapPanel>
                  <Border IsVisible="{Binding Workspace.ShowInitialSaveUploadPrompt}" Background="#4A3A1C" BorderBrush="#E5B64A" BorderThickness="1" CornerRadius="8" Padding="12" AutomationProperties.Name="Existing save upload confirmation">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Existing files were found in this save folder. Upload them to the paired device now? Confirm that this is the correct game's save folder." TextWrapping="Wrap" />
                      <WrapPanel ItemSpacing="8">
                        <Button Content="Upload existing saves" Click="OnSyncSelectedGameNow" AutomationProperties.Name="Confirm upload of existing save files" />
                        <Button Content="Not now" Click="OnDismissInitialSaveUpload" AutomationProperties.Name="Decline upload of existing save files" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="Conflict recovery" FontWeight="SemiBold" />
                  <WrapPanel ItemSpacing="8">
                    <Button Content="Keep local" Click="OnKeepLocalSave" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Resolve save conflict by keeping local files" />
                    <Button Content="Use remote" Click="OnKeepRemoteSave" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Resolve save conflict by restoring remote files" />
                    <Button Content="Keep both" Click="OnKeepBothSaves" IsEnabled="{Binding Workspace.CanConfigureSaveFolder}" AutomationProperties.Name="Resolve save conflict by retaining both versions" />
                  </WrapPanel>
                  <TextBlock Text="Snapshot history" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="Snapshots are integrity-checked and retained locally. Restoring creates a backup of the current folder first." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
                  <ListBox ItemsSource="{Binding Workspace.SaveSnapshotHistory}" SelectedItem="{Binding Workspace.SelectedSaveSnapshot}" MaxHeight="220" AutomationProperties.Name="Retained save snapshot history">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="saves:SaveSnapshotHistoryItem">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4">
                          <StackPanel>
                            <TextBlock Text="{Binding CreatedAtUtc, StringFormat='{}{0:g}'}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SnapshotId}" FontSize="11" Foreground="{DynamicResource ThemeMuted}" />
                            <TextBlock Text="{Binding Error}" IsVisible="{Binding !IntegrityValid}" TextWrapping="Wrap" Foreground="#E56565" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" />
                            <TextBlock Text="{Binding IntegrityValid, StringFormat='Integrity: {0}'}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel ItemSpacing="8">
                    <Button Content="Refresh history" Click="OnRefreshSnapshotHistory" AutomationProperties.Name="Refresh selected game save snapshot history" />
                    <Button Content="Restore selected snapshot" Click="OnRestoreSelectedSnapshot" IsEnabled="{Binding Workspace.CanRestoreSelectedSnapshot}" AutomationProperties.Name="Restore selected verified save snapshot" />
                  </WrapPanel>
                  <TextBlock Text="Restore history" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <ItemsControl ItemsSource="{Binding Workspace.SaveRestoreHistory}" AutomationProperties.Name="Bounded save restore history">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="saves:SaveRestoreHistoryItem">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="4">
                          <TextBlock Text="{Binding CreatedAtUtc, StringFormat='{}{0:g}'}" />
                          <TextBlock Grid.Column="1" Text="{Binding Outcome}" />
                          <TextBlock Grid.Column="2" Text="{Binding BackedUpFileCount, StringFormat='{}{0} files'}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <TextBlock Text="About" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="{Binding Workspace.SelectedGameDescription}" TextWrapping="Wrap" FontSize="15" />
              <TextBlock Text="Achievements" FontSize="22" FontWeight="Bold" Margin="0,12,0,0" />
              <Button Content="Refresh achievements" Click="OnRefreshAchievements" HorizontalAlignment="Left" />
              <ItemsControl ItemsSource="{Binding Workspace.Achievements}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" CornerRadius="16" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Game details" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Developer" Foreground="{DynamicResource ThemeMuted}" /><TextBlock Text="{Binding Workspace.SelectedGameDevelopers}" TextWrapping="Wrap" />
                <TextBlock Text="Publisher" Foreground="{DynamicResource ThemeMuted}" /><TextBlock Text="{Binding Workspace.SelectedGamePublishers}" TextWrapping="Wrap" />
                <TextBlock Text="Released" Foreground="{DynamicResource ThemeMuted}" /><TextBlock Text="{Binding Workspace.SelectedGameReleaseDate}" />
                <TextBlock Text="Playtime" Foreground="{DynamicResource ThemeMuted}" /><TextBlock Text="{Binding Workspace.SelectedGamePlayTime}" FontSize="18" FontWeight="SemiBold" />
                <CheckBox Content="Run this game as administrator" IsChecked="{Binding Workspace.RunSelectedAsAdministrator}" IsEnabled="{Binding Workspace.CanRunAsAdministrator}" AutomationProperties.Name="Request administrator permission for this game" />
                <TextBlock Text="Windows will show a UAC approval prompt. NovaLauncher never bypasses UAC." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
                <Button Content="Remove from NovaLauncher" Click="OnRemove" AutomationProperties.Name="Remove selected game from NovaLauncher" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding Workspace.IsHomePage}">
        <StackPanel Margin="34,30" Spacing="22">
          <StackPanel>
            <TextBlock Text="Welcome home" Classes="page-title" />
            <TextBlock Text="Your games, favorites, and recent additions in one calm place." FontSize="16" Foreground="{DynamicResource ThemeMuted}" />
          </StackPanel>
          <Border Classes="elevated-card" IsVisible="{Binding Workspace.HasFeaturedGame}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="8">
                <TextBlock Text="CONTINUE PLAYING" Classes="eyebrow" />
                <TextBlock Text="{Binding Workspace.FeaturedGame.Name}" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Workspace.FeaturedGame.Platform}" Foreground="{DynamicResource ThemeMuted}" />
                <TextBlock Text="NovaLauncher measures playtime only for directly monitored local executable sessions." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" MaxWidth="620" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" DataContext="{Binding Workspace.FeaturedGame}">
                <Button Classes="primary" Content="Play now" Click="OnLaunchHomeGame" AutomationProperties.Name="Launch featured game" />
                <Button Content="View details" Click="OnOpenGameDetails" AutomationProperties.Name="Open featured game details" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Classes="card" Padding="18"><StackPanel><TextBlock Text="LIBRARY" Classes="eyebrow" /><TextBlock Text="{Binding Workspace.LibraryGameCount}" FontSize="28" FontWeight="Bold" /><TextBlock Text="games on this device" Foreground="{DynamicResource ThemeMuted}" /></StackPanel></Border>
            <Border Grid.Column="1" Classes="card" Padding="18"><StackPanel><TextBlock Text="FAVORITES" Classes="eyebrow" /><TextBlock Text="{Binding Workspace.FavoriteGameCount}" FontSize="28" FontWeight="Bold" /><TextBlock Text="marked favorites" Foreground="{DynamicResource ThemeMuted}" /></StackPanel></Border>
            <Border Grid.Column="2" Classes="card" Padding="18"><StackPanel><TextBlock Text="LOCAL PLAYTIME" Classes="eyebrow" /><TextBlock Text="{Binding Workspace.TotalLibraryPlayTime}" FontSize="28" FontWeight="Bold" /><TextBlock Text="direct sessions only" Foreground="{DynamicResource ThemeMuted}" /></StackPanel></Border>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Favorites and recent additions" FontSize="22" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Browse library" Click="OnShowLibrary" AutomationProperties.Name="Browse complete game library" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Workspace.HomeGames}" AutomationProperties.Name="Home game highlights">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemWidth="220" ItemHeight="270" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:LibraryItem">
                <Button Classes="game-card" Width="206" Height="256" Padding="0" Margin="0,0,14,14" Click="OnOpenGameDetails" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Open highlighted game details">
                  <Grid RowDefinitions="190,*">
                    <Border Background="{DynamicResource ThemeElevated}" CornerRadius="14,14,0,0" ClipToBounds="True">
                      <Grid>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14" />
                        <Image Stretch="UniformToFill" Loaded="OnCardArtworkLoaded" Unloaded="OnCardArtworkUnloaded" RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="Highlighted game cover artwork" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="14,8" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeMuted}" />
                    <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource ThemeAccent}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Recently played" FontSize="22" FontWeight="SemiBold" IsVisible="{Binding Workspace.HasContinuePlayingGames}" />
          <ItemsControl ItemsSource="{Binding Workspace.ContinuePlayingGames}" AutomationProperties.Name="Recently played games">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:LibraryItem">
                <Button Content="{Binding Name}" Margin="0,0,8,8" Click="OnOpenGameDetails" AutomationProperties.Name="Open recently played game details" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Most played" FontSize="22" FontWeight="SemiBold" IsVisible="{Binding Workspace.HasMostPlayedGames}" />
          <ItemsControl ItemsSource="{Binding Workspace.MostPlayedGames}" AutomationProperties.Name="Most played games">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:LibraryItem">
                <Button Content="{Binding Name}" Margin="0,0,8,8" Click="OnOpenGameDetails" AutomationProperties.Name="Open most played game details" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No games yet? Open Library to import Steam or add an installed game." IsVisible="{Binding Workspace.IsEmpty}" Foreground="{DynamicResource ThemeMuted}" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding Workspace.IsSavesPage}">
        <StackPanel Margin="34,30" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Downloads &amp; Saves" Classes="page-title" />
          <TextBlock Text="Track encrypted cross-device saves and explicitly authorized experimental peer game transfers." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" />
          <Border Background="{DynamicResource ThemeElevated}" CornerRadius="16" Padding="24">
            <StackPanel Spacing="10">
              <TextBlock Text="Current transfer" FontSize="21" FontWeight="SemiBold" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Workspace.IsSaveTransferActive}" Height="8" AutomationProperties.Name="Current save transfer progress" />
              <TextBlock Text="{Binding Workspace.ActiveSaveTransfer}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel Spacing="12">
              <TextBlock Text="Transfer history" FontSize="21" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Workspace.SaveSyncActivities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="12">
                        <StackPanel><TextBlock Text="{Binding GameName}" FontWeight="SemiBold" /><TextBlock Text="{Binding SnapshotId}" FontSize="11" Foreground="{DynamicResource ThemeMuted}" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat='{}{0} files'}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel ItemSpacing="8">
                <Button Content="Retry queued uploads" Click="OnRetryPendingSaveUploads" AutomationProperties.Name="Retry queued save uploads to paired device" />
                <Button Content="Refresh activity" Click="OnRefreshSaveSyncActivity" AutomationProperties.Name="Refresh save transfer activity" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeElevated}" CornerRadius="16" Padding="24">
            <StackPanel Spacing="12">
              <TextBlock Text="Private game transfer (experimental)" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="For a manually added, DRM-free game folder you are authorized to copy. Steam and store-managed folders are rejected. Received executables are never launched automatically." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
              <TextBlock Text="Offer a manual game" FontWeight="SemiBold" />
              <TextBox Text="{Binding Workspace.GameTransferSourceFolder}" PlaceholderText="Source game folder" AutomationProperties.Name="Authorized manual game source folder" />
              <WrapPanel ItemSpacing="8">
                <Button Content="Choose source folder" Click="OnChooseGameTransferSource" AutomationProperties.Name="Choose manual game transfer source folder" />
                <Button Content="Preview manifest" Click="OnPreviewGameTransfer" AutomationProperties.Name="Preview bounded game transfer manifest" />
              </WrapPanel>
              <TextBlock Text="{Binding Workspace.GameTransferPreview.Files.Count, StringFormat='Preview: {0} files'}" IsVisible="{Binding Workspace.HasGameTransferPreview}" />
              <TextBlock Text="{Binding Workspace.GameTransferPreview.TotalBytes, StringFormat='Total: {0:N0} bytes'}" IsVisible="{Binding Workspace.HasGameTransferPreview}" />
              <ComboBox ItemsSource="{Binding Workspace.TrustedSaveSyncPeers}" SelectedItem="{Binding Workspace.SelectedTrustedPeer}" PlaceholderText="Choose one trusted recipient" AutomationProperties.Name="Trusted game transfer recipient">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="syncDomain:TrustedSaveSyncPeer"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Content="I confirm I am authorized to copy and transfer this DRM-free game folder" IsChecked="{Binding Workspace.GameTransferRightsAttested}" Foreground="{DynamicResource ThemeText}" AutomationProperties.Name="Attest game copy rights" />
              <Button Content="Authorize 24-hour offer" Click="OnAuthorizeGameTransfer" IsEnabled="{Binding Workspace.HasGameTransferPreview}" HorizontalAlignment="Left" AutomationProperties.Name="Authorize reviewed game transfer to selected peer" />
              <TextBlock Text="Receive an authorized offer" FontWeight="SemiBold" Margin="0,8,0,0" />
              <Button Content="Refresh offers" Click="OnRefreshGameTransferOffers" HorizontalAlignment="Left" AutomationProperties.Name="Refresh authorized peer game transfer offers" />
              <ListBox ItemsSource="{Binding Workspace.PeerGameTransferOffers}" SelectedItem="{Binding Workspace.SelectedGameTransferOffer}" MaxHeight="180" AutomationProperties.Name="Authorized peer game transfer offers">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="transfers:PeerGameTransferOffer">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4">
                      <StackPanel><TextBlock Text="{Binding Manifest.PackageName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Peer.DisplayName}" Foreground="{DynamicResource ThemeMuted}" /></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Manifest.TotalBytes, StringFormat='{}{0:N0} bytes'}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBox Text="{Binding Workspace.GameTransferDestination}" PlaceholderText="Empty destination folder" AutomationProperties.Name="Game transfer destination folder" />
              <WrapPanel ItemSpacing="8">
                <Button Content="Choose destination" Click="OnChooseGameTransferDestination" AutomationProperties.Name="Choose empty game transfer destination" />
                <Button Content="Download or resume" Click="OnDownloadGameTransfer" AutomationProperties.Name="Download or resume verified peer game transfer" />
                <Button Content="Pause" Click="OnPauseGameTransfer" IsEnabled="{Binding Workspace.IsGameTransferActive}" AutomationProperties.Name="Pause active game transfer" />
              </WrapPanel>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Workspace.GameTransferProgress}" Height="8" AutomationProperties.Name="Peer game transfer byte progress" />
              <TextBlock Text="{Binding Workspace.GameTransferStatus}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Workspace.GameTransferHistory}" AutomationProperties.Name="Local peer game transfer audit history">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="transfers:GameTransferAuditItem"><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeElevated}" CornerRadius="16" Padding="24">
            <StackPanel Spacing="12">
              <TextBlock Text="Local NovaLauncher backup" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="Export or validate a backup of your library, collections, settings, and manual overrides. Disposable caches and secrets are excluded." TextWrapping="Wrap" />
              <TextBox Text="{Binding Workspace.BackupPath}" PlaceholderText="C:\Backups\NovaLauncher.zip" AutomationProperties.Name="Saves page backup archive path" />
              <WrapPanel ItemSpacing="8">
                <Button Content="Export local backup" Click="OnExport" AutomationProperties.Name="Export local NovaLauncher backup from Saves page" />
                <Button Content="{Binding Workspace.RestoreButtonText}" Click="OnRestore" AutomationProperties.Name="Restore local NovaLauncher backup from Saves page" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="24">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6">
                <TextBlock Text="Cross-device save linking" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Available experimentally for explicitly mapped manual games after both NovaLauncher devices are paired over Tailscale. Conflicts block launch rather than overwriting either save." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Configure in Settings" Click="OnShowSettings" AutomationProperties.Name="Configure cross-device save linking" />
            </Grid>
          </Border>
          <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
            <TextBlock Text="Before restoring a verified peer snapshot, NovaLauncher creates a local versioned backup. Steam games are never handled by this feature." TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" IsVisible="{Binding Workspace.IsSettingsPage}">
        <StackPanel Margin="34,30" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Settings &amp; Diagnostics" Classes="page-title" />
          <TextBlock Text="Appearance and local health information. Diagnostics remain on this device." Foreground="{DynamicResource ThemeMuted}" />
          <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel Spacing="12">
              <TextBlock Text="Appearance" FontSize="21" FontWeight="SemiBold" />
              <ComboBox
                  ItemsSource="{Binding Workspace.ThemeOptions}"
                  SelectedValue="{Binding Workspace.SelectedThemeId}"
                  SelectedValueBinding="{Binding Id}"
                  AutomationProperties.Name="Built-in color theme">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="themes:ThemeOption"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Apply theme" Click="OnApplyTheme" AutomationProperties.Name="Apply selected built-in theme" />
              <CheckBox Content="Reduce motion" IsChecked="{Binding Workspace.ReduceMotion}" AutomationProperties.Name="Reduce interface motion" />
              <Button Content="Apply motion preference" Click="OnApplyMotionPreference" AutomationProperties.Name="Apply interface motion preference" />
              <TextBlock Text="Five trusted built-in themes are available. Downloaded/community themes are not loaded." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel Spacing="10">
              <TextBlock Text="SteamGridDB artwork" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="Paste your SteamGridDB API key to enable optional cover-art lookup. The key is held only for this running session and is never logged or written into library backups." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
              <TextBox PasswordChar="●" Text="{Binding Workspace.SteamGridDbApiKey}" PlaceholderText="SteamGridDB API key" AutomationProperties.Name="SteamGridDB API key" />
              <Button Content="Apply API key" Click="OnApplySteamGridDbKey" HorizontalAlignment="Left" AutomationProperties.Name="Apply SteamGridDB API key for this session" />
              <TextBlock Text="{Binding Workspace.SteamGridDbKeyStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel Spacing="10">
              <TextBlock Text="Tailscale save-sync foundation" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="On both devices, enter and save the other device's Tailscale IP. Generate the code on one device, keep NovaLauncher open there, then accept the code on the second device." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
              <TextBlock Text="{Binding Workspace.SaveSyncIdentity}" TextWrapping="Wrap" AutomationProperties.Name="Stable NovaLauncher device identity" />
              <TextBox Text="{Binding Workspace.TailscalePeerAddress}" PlaceholderText="100.64.x.x or fd7a:115c:a1e0::…" AutomationProperties.Name="Tailscale peer IP address" />
              <Button Content="Validate and save peer" Click="OnSaveTailscalePeer" HorizontalAlignment="Left" AutomationProperties.Name="Validate and save Tailscale peer address" />
              <Button Content="Retry network listener" Click="OnRetrySaveSyncListener" HorizontalAlignment="Left" AutomationProperties.Name="Retry Tailscale save-sync network listener" />
              <Border IsVisible="{Binding Workspace.IsSaveSyncListening}" Background="#183D2C" BorderBrush="#4EC98A" BorderThickness="1" CornerRadius="8" Padding="10">
                <TextBlock Text="{Binding Workspace.SaveSyncListenerStatus, StringFormat='NETWORK READY · {0}'}" TextWrapping="Wrap" AutomationProperties.Name="Save sync listener ready" />
              </Border>
              <Border IsVisible="{Binding Workspace.IsSaveSyncNotListening}" Background="#4A2424" BorderBrush="#E56565" BorderThickness="1" CornerRadius="8" Padding="10">
                <TextBlock Text="{Binding Workspace.SaveSyncListenerStatus, StringFormat='NETWORK NOT READY · {0}'}" TextWrapping="Wrap" AutomationProperties.Name="Save sync listener inactive" />
              </Border>
              <Border IsVisible="{Binding Workspace.IsSaveSyncPaired}" Background="#263F73" BorderBrush="#5B8DEF" BorderThickness="2" CornerRadius="10" Padding="12" AutomationProperties.Name="Save sync paired status">
                <StackPanel Spacing="4">
                  <TextBlock Text="PAIRED" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="{Binding Workspace.SaveSyncPairingStatus}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border IsVisible="{Binding Workspace.IsSaveSyncNotPaired}" Background="#4A2E1E" BorderBrush="#E59A45" BorderThickness="2" CornerRadius="10" Padding="12" AutomationProperties.Name="Save sync not paired status">
                <StackPanel Spacing="4">
                  <TextBlock Text="NOT PAIRED" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="{Binding Workspace.SaveSyncPairingStatus}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Workspace.SaveSyncPairingFeedback}" TextWrapping="Wrap" AutomationProperties.Name="Save sync pairing result" />
              <TextBox PasswordChar="●" Text="{Binding Workspace.PairingCode}" PlaceholderText="123 456" AutomationProperties.Name="NovaLauncher 24-hour device invitation" />
              <WrapPanel ItemSpacing="8">
                <Button Content="Generate 24-hour invitation" Click="OnGeneratePairingCode" AutomationProperties.Name="Generate a single-use 24-hour save-sync invitation" />
                <Button Content="Copy code" Click="OnCopyInvitationCode" AutomationProperties.Name="Copy six-digit invitation code" />
                <Button Content="Paste code" Click="OnPasteInvitationCode" AutomationProperties.Name="Paste six-digit invitation code" />
                <Button Content="Accept invitation" Click="OnApplyPairingCode" IsEnabled="{Binding Workspace.CanAcceptPairingInvitation}" AutomationProperties.Name="Accept save-sync invitation from trusted device" />
                <Button Content="Refresh pairing status" Click="OnRefreshPairingStatus" AutomationProperties.Name="Refresh save-sync pairing status" />
                <Button Content="Revoke paired device" Click="OnRevokePairedDevice" AutomationProperties.Name="Revoke the paired save-sync device" />
              </WrapPanel>
              <TextBlock Text="Accept invitation becomes available after the other device's Tailscale IP is entered and the invitation field contains six digits." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
              <TextBlock Text="Trusted devices" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
              <ListBox ItemsSource="{Binding Workspace.TrustedSaveSyncPeers}" SelectedItem="{Binding Workspace.SelectedTrustedPeer}" MaxHeight="180" AutomationProperties.Name="Independently trusted save-sync devices">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="syncDomain:TrustedSaveSyncPeer">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{DynamicResource ThemeMuted}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBox Text="{Binding Workspace.TrustedPeerName}" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" PlaceholderText="Trusted device name" AutomationProperties.Name="Selected trusted device name" />
              <WrapPanel ItemSpacing="8">
                <Button Content="Rename selected" Click="OnRenameTrustedPeer" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" AutomationProperties.Name="Rename selected trusted device" />
                <Button Content="Pause or resume" Click="OnToggleTrustedPeer" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" AutomationProperties.Name="Pause or resume selected trusted device" />
                <Button Content="Revoke selected" Click="OnRevokeTrustedPeer" IsEnabled="{Binding Workspace.HasSelectedTrustedPeer}" AutomationProperties.Name="Independently revoke selected trusted device" />
              </WrapPanel>
              <TextBlock Text="Steam-imported games are excluded and continue to use Steam Cloud where supported." TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="24">
            <StackPanel Spacing="10">
              <TextBlock Text="Official updates" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="NovaLauncher checks the fixed official GitHub repository only when you ask. Downloads require an exact SHA-256 match and a pinned valid Windows publisher signature before staging." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
              <ComboBox ItemsSource="{Binding Workspace.UpdateChannelOptions}" SelectedItem="{Binding Workspace.SelectedUpdateChannel}" AutomationProperties.Name="Official NovaLauncher update channel" />
              <WrapPanel ItemSpacing="8">
                <Button Content="Check for updates" Click="OnCheckForUpdates" AutomationProperties.Name="Check official NovaLauncher releases" />
                <Button Content="Verify and stage installer" Click="OnStageUpdate" IsEnabled="{Binding Workspace.HasAvailableUpdate}" AutomationProperties.Name="Verify and stage signed NovaLauncher installer" />
              </WrapPanel>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Workspace.UpdateProgress}" Height="8" AutomationProperties.Name="Official update download progress" />
              <TextBlock Text="{Binding Workspace.UpdateStatus}" TextWrapping="Wrap" AutomationProperties.Name="Official update status" />
              <TextBlock Text="{Binding Workspace.AvailableUpdate.ReleaseNotes}" IsVisible="{Binding Workspace.HasAvailableUpdate}" MaxHeight="180" TextWrapping="Wrap" AutomationProperties.Name="Official update release notes" />
              <CheckBox Content="I reviewed the release notes and want Windows Setup to open the verified installer" IsChecked="{Binding Workspace.ConfirmUpdateInstall}" AutomationProperties.Name="Confirm launching verified NovaLauncher installer" />
              <Button Content="Open verified installer" Click="OnLaunchStagedUpdate" IsEnabled="{Binding Workspace.CanLaunchStagedUpdate}" HorizontalAlignment="Left" AutomationProperties.Name="Open reverified NovaLauncher installer" />
              <TextBlock Text="Installation is never automatic. The staged file is rechecked immediately before Windows Setup opens it. Unsigned builds without an embedded publisher-certificate pin fail closed." TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeElevated}" CornerRadius="16" Padding="24">
            <StackPanel Spacing="8">
              <TextBlock Text="Local diagnostics" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Version, StringFormat='NovaLauncher version: {0}'}" />
              <TextBlock Text="{Binding Workspace.Games.Count, StringFormat='Visible library items: {0}'}" />
              <TextBlock Text="{Binding Workspace.AchievementSummary, StringFormat='Achievements: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="Network activity occurs only when you explicitly import or refresh provider data." TextWrapping="Wrap" />
              <TextBlock Text="Logs are structured and local; API keys and raw configured account IDs are not logged." TextWrapping="Wrap" />
              <TextBlock Text="{Binding Workspace.CrashRecoveryStatus}" TextWrapping="Wrap" AutomationProperties.Name="Previous session recovery status" />
              <Button Content="Export sanitized diagnostics" Click="OnExportDiagnostics" HorizontalAlignment="Left" AutomationProperties.Name="Export sanitized local diagnostics" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="22,11">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
        <TextBlock
            Grid.Column="1"
            Text="{Binding Workspace.Status}"
            TextWrapping="Wrap"
            AutomationProperties.Name="NovaLauncher operation status"
            AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>
    <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding Workspace.IsBusy}" AutomationProperties.Name="NovaLauncher operation in progress" />
  </Grid>
</Window>
